# === Database ===
DATABASE_URL=postgresql+psycopg2://nova_user:nova_password@localhost:5432/nova_db

# === JWT Authentication ===
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# === Application ===
APP_ENV=development
APP_NAME=N.O.V.A

# === OpenRouter (AI Gateway) ===
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_TITLE=N.O.V.A

# === Model Router (task category -> model) ===
# Boleh diganti kapan saja tanpa mengubah kode.
GENERAL_CHAT_MODEL=openai/gpt-4o-mini
TECHNICAL_REASONING_MODEL=anthropic/claude-3.5-sonnet
TROUBLESHOOTING_MODEL=anthropic/claude-3.5-sonnet
NETWORK_DIAGNOSTIC_MODEL=openai/gpt-4o-mini
CONFIGURATION_GENERATION_MODEL=anthropic/claude-3.5-sonnet
CODING_MODEL=anthropic/claude-3.5-sonnet
SUMMARIZATION_MODEL=openai/gpt-4o-mini
FALLBACK_MODEL=openai/gpt-4o-mini
