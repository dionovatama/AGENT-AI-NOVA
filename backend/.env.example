# === Database ===
DATABASE_URL=postgresql+psycopg2://nova_user:nova_password@localhost:5432/nova_db

# === JWT Authentication ===
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# === Application ===
APP_ENV=development
APP_NAME=N.O.V.A

# === OpenRouter (AI Gateway) ===
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_TITLE=N.O.V.A

# === Model Router (task category -> model) ===
# Boleh diganti kapan saja tanpa mengubah kode.
GENERAL_CHAT_MODEL=openai/gpt-4o-mini
TECHNICAL_REASONING_MODEL=anthropic/claude-3.5-sonnet
TROUBLESHOOTING_MODEL=anthropic/claude-3.5-sonnet
NETWORK_DIAGNOSTIC_MODEL=openai/gpt-4o-mini
CONFIGURATION_GENERATION_MODEL=anthropic/claude-3.5-sonnet
CODING_MODEL=anthropic/claude-3.5-sonnet
SUMMARIZATION_MODEL=openai/gpt-4o-mini

# KOREKSI (sebelumnya catatan di sini salah): "openrouter/free" TERNYATA
# model ID valid -- ini "Free Models Router" resmi OpenRouter, yang
# otomatis memilih model gratis yang mendukung fitur request (termasuk
# tool calling). Dikonfirmasi lewat dokumentasi openrouter.ai/openrouter/free.
# Untuk testing tanpa credit, gunakan model dengan akhiran ":free", contoh:
# liquid/lfm-2.5-2.6b:free, nvidia/nemotron-3.5-lightning:free, atau
# openrouter/free itu sendiri sebagai router otomatis.
FALLBACK_MODEL=openai/gpt-4o-mini

# Reasoning model (mis. nemotron) menghabiskan token budget untuk proses
# reasoning sebelum menulis jawaban akhir — 1024 sering membuat response
# kosong dan dianggap gagal. Dinaikkan lagi ke 8192 (dari 4096) karena
# jalur tool-calling butuh reasoning lebih berat untuk merangkum hasil
# web.search/web.read_page sebelum menulis jawaban akhir.
OPENROUTER_MAX_TOKENS=8192

# Model khusus jalur tool-calling (web.search/web.read_page). Terpisah
# dari GENERAL_CHAT_MODEL karena tidak semua model chat biasa reliable
# untuk function-calling. nex-n2-pro:free (pilihan lama) sudah 404 --
# provider gratisnya ditarik OpenRouter -- diganti ke N2.5. Model ini
# resmi diumumkan OpenRouter sebagai "free for a limited time", jadi
# berpotensi perlu diganti lagi nanti -- cek status di openrouter.ai
# dulu sebelum menyalahkan kode kalau 404 lagi.
TOOL_CALLING_MODEL=nex-agi/nex-n2.5-mini:free
# Fallback khusus tool-calling -- Free Models Router resmi, otomatis
# memfilter model gratis yang mendukung tool calling.
TOOL_CALLING_FALLBACK_MODEL=openrouter/free

# Membatasi porsi OPENROUTER_MAX_TOKENS yang dipakai untuk reasoning
# tersembunyi (dokumentasi OpenRouter: reasoning.effort). 'low' menyisakan
# lebih banyak token untuk jawaban yang benar-benar terlihat user.
# Valid: high | medium | low | minimal | none
OPENROUTER_REASONING_EFFORT=low

# === Linux Executor (SSH) ===
LINUX_SSH_HOST=192.168.1.10
LINUX_SSH_PORT=22
LINUX_SSH_USERNAME=nova
LINUX_SSH_PRIVATE_KEY_PATH=./secrets/nova_backend_key
LINUX_SSH_CONNECT_TIMEOUT_SECONDS=10

# === Audit Log Retention (PRD section 32/33) ===
# Baris audit_logs lebih tua dari ini dihapus otomatis lewat background
# task, sekali sehari. SENGAJA tidak ada endpoint/tombol hapus manual --
# lihat app/security/audit_retention.py untuk alasannya.
AUDIT_LOG_RETENTION_DAYS=90