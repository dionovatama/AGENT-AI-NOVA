# === Database ===
DATABASE_URL=postgresql+psycopg2://nova_user:nova_password@localhost:5432/nova_db

# === JWT Authentication ===
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# === Application ===
APP_ENV=development
APP_NAME=N.O.V.A

# === OpenRouter (AI Gateway) ===
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_TITLE=N.O.V.A

# === Model Router (task category -> model) ===
# Boleh diganti kapan saja tanpa mengubah kode.
GENERAL_CHAT_MODEL=openai/gpt-4o-mini
TECHNICAL_REASONING_MODEL=anthropic/claude-3.5-sonnet
TROUBLESHOOTING_MODEL=anthropic/claude-3.5-sonnet
NETWORK_DIAGNOSTIC_MODEL=openai/gpt-4o-mini
CONFIGURATION_GENERATION_MODEL=anthropic/claude-3.5-sonnet
CODING_MODEL=anthropic/claude-3.5-sonnet
SUMMARIZATION_MODEL=openai/gpt-4o-mini

# CATATAN: "openrouter/free" BUKAN model ID yang valid (bukan format
# <provider>/<model-name>) — akan membuat fallback gagal. Untuk testing
# tanpa credit, gunakan model dengan akhiran ":free", contoh:
# liquid/lfm-2.5-2.6b:free atau nvidia/nemotron-3.5-lightning:free
FALLBACK_MODEL=openai/gpt-4o-mini

# Reasoning model (mis. nemotron) menghabiskan token budget untuk proses
# reasoning sebelum menulis jawaban akhir — 1024 sering membuat response
# kosong dan dianggap gagal. Dinaikkan lagi ke 8192 (dari 4096) karena
# jalur tool-calling butuh reasoning lebih berat untuk merangkum hasil
# web.search/web.read_page sebelum menulis jawaban akhir.
OPENROUTER_MAX_TOKENS=8192

# Membatasi porsi OPENROUTER_MAX_TOKENS yang dipakai untuk reasoning
# tersembunyi (dokumentasi OpenRouter: reasoning.effort). 'low' menyisakan
# lebih banyak token untuk jawaban yang benar-benar terlihat user.
# Valid: high | medium | low | minimal | none
OPENROUTER_REASONING_EFFORT=low

# === Linux Executor (SSH) ===
LINUX_SSH_HOST=192.168.1.10
LINUX_SSH_PORT=22
LINUX_SSH_USERNAME=nova
LINUX_SSH_PRIVATE_KEY_PATH=./secrets/nova_backend_key
LINUX_SSH_CONNECT_TIMEOUT_SECONDS=10